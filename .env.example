# ---- Claude (console.anthropic.com) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# ---- Visuals: "code" (Claude-written animations) or "image" ----
VISUAL_MODE=code

# ---- Images (only used when VISUAL_MODE=image): "openai" (AI-generated) or "pexels" (free stock photos) ----
IMAGE_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1
PEXELS_API_KEY=

# ---- Voice: "elevenlabs" or "openai" ----
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# ---- Instagram (Meta developer app) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
# graph.facebook.com for "Instagram API with Facebook Login"
# graph.instagram.com for "Instagram API with Instagram Login"
IG_GRAPH_HOST=graph.facebook.com
GRAPH_API_VERSION=v23.0
